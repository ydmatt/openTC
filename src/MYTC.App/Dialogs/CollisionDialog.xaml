<Window x:Class="MYTC.App.Dialogs.CollisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="目标中存在同名项目"
        Width="520"
        Height="215"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="15"
                   FontWeight="SemiBold"
                   Text="目标目录中存在一个或多个同名项目。" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="请选择本次操作的统一处理方式。“替换”会先删除同名目标；重要文件建议选择“两者保留”或“跳过”。" />
        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="88" Click="OnKeepBothClick" Content="两者保留" />
            <Button MinWidth="78" Margin="8,0,0,0" Click="OnSkipClick" Content="跳过" />
            <Button MinWidth="78" Margin="8,0,0,0" Click="OnReplaceClick" Content="替换" />
            <Button MinWidth="78" Margin="8,0,0,0" Content="取消" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
