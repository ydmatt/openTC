<Window x:Class="MYTC.App.Dialogs.ContextMenuSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="右键菜单设置"
        Width="920"
        Height="650"
        MinWidth="760"
        MinHeight="500"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Margin="0,0,0,10"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="可隐藏、改名和调整内置项顺序，也可加入外部程序。“新建”是两级菜单，其子项会显示为二级。菜单文字中写 &amp;A 可将 A 设为访问键。参数变量：{path}=首个项目，{paths}=全部所选项目，{directory}=当前目录。" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="右键菜单方案" />
            <ComboBox x:Name="SchemeComboBox"
                      Grid.Column="1"
                      Margin="8,0,0,0" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Click="OnLoadSchemeClick"
                    Content="载入方案" />
            <Button Grid.Column="3"
                    Margin="8,0,0,0"
                    Click="OnSaveSchemeClick"
                    Content="保存为方案…" />
        </Grid>

        <DataGrid x:Name="MenuGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="58"
                                        Header="显示"
                                        Binding="{Binding IsVisible}" />
                <DataGridTextColumn Width="90"
                                    Header="类型"
                                    Binding="{Binding KindLabel}"
                                    IsReadOnly="True" />
                <DataGridTextColumn Width="76"
                                    Header="层级"
                                    Binding="{Binding LevelLabel}"
                                    IsReadOnly="True" />
                <DataGridTextColumn Width="190"
                                    Header="菜单文字"
                                    Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Width="280"
                                    Header="程序路径"
                                    Binding="{Binding ProgramPath, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Width="220"
                                    Header="参数"
                                    Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
            <Button Click="OnAddProgramClick" Content="添加外部程序…" />
            <Button Margin="7,0,0,0" Click="OnAddSeparatorClick" Content="添加分隔线" />
            <Button Margin="18,0,0,0" Click="OnMoveUpClick" Content="上移" />
            <Button Margin="7,0,0,0" Click="OnMoveDownClick" Content="下移" />
            <Button Margin="7,0,0,0" Click="OnRemoveClick" Content="删除自定义项" />
            <Button Margin="18,0,0,0"
                    Click="OnRestoreDefaultsClick"
                    Content="恢复默认" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="92" Click="OnSaveClick" Content="保存并应用" IsDefault="True" />
            <Button MinWidth="78" Margin="8,0,0,0" Content="取消" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
