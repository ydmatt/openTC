<Window x:Class="MYTC.App.Dialogs.TabSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签设置"
        Width="520"
        Height="260"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock VerticalAlignment="Center" Text="显示标题" />
        <TextBox x:Name="TitleTextBox"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Margin="0,0,0,12" />

        <CheckBox x:Name="FixedCheckBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,12"
                  Checked="OnFixedChanged"
                  Unchecked="OnFixedChanged"
                  Content="固定标签：每次再次点击此标签时回到固定目录" />

        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="固定目录" />
        <TextBox x:Name="FixedPathTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="0,0,8,0" />
        <Button x:Name="BrowseButton"
                Grid.Row="2"
                Grid.Column="2"
                MinWidth="68"
                Click="OnBrowseClick"
                Content="浏览…" />

        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="普通标签保存最后访问位置。固定标签仍可浏览其他目录；切换走后再次点击，会回到这里。" />

        <StackPanel Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="78" Click="OnOkClick" Content="确定" IsDefault="True" />
            <Button MinWidth="78" Margin="8,0,0,0" Content="取消" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
