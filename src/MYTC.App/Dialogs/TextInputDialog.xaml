<Window x:Class="MYTC.App.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        Height="170"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptTextBlock" />
        <TextBox x:Name="ValueTextBox" Grid.Row="1" Margin="0,7,0,12" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="78" Click="OnOkClick" Content="确定" IsDefault="True" />
            <Button MinWidth="78" Margin="8,0,0,0" Content="取消" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
