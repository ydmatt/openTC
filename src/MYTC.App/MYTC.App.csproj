<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MYTC</AssemblyName>
    <RootNamespace>MYTC.App</RootNamespace>
    <Version>1.0.25</Version>
    <AssemblyVersion>1.0.25.0</AssemblyVersion>
    <FileVersion>1.0.25.0</FileVersion>
    <AssemblyTitle>openTC</AssemblyTitle>
    <Product>openTC 开源四窗格资源管理器</Product>
    <Description>openTC：受 Total Commander 启发的 Windows 开源四窗格文件管理器。</Description>
    <ApplicationIcon>Assets\mytc.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\mytc.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MYTC.Application\MYTC.Application.csproj" />
    <ProjectReference Include="..\MYTC.Domain\MYTC.Domain.csproj" />
    <ProjectReference Include="..\MYTC.Infrastructure\MYTC.Infrastructure.csproj" />
  </ItemGroup>
</Project>
