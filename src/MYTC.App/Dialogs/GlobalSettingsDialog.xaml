<Window x:Class="MYTC.App.Dialogs.GlobalSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局设置"
        Width="520"
        Height="275"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="16"
                   FontWeight="SemiBold"
                   Text="基础行为" />
        <CheckBox x:Name="StartWithWindowsCheckBox"
                  Grid.Row="1"
                  Margin="0,18,0,0"
                  Content="登录 Windows 后自动启动 MYTC" />
        <CheckBox x:Name="ConfirmRecycleDeleteCheckBox"
                  Grid.Row="2"
                  Margin="0,15,0,0"
                  Content="将文件或文件夹移到回收站前显示确认窗口" />
        <TextBlock Grid.Row="3"
                   Margin="0,16,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="永久删除始终要求确认。便携版移动到其他目录后，请重新保存一次开机启动设置，以更新程序路径。" />
        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="82"
                    Click="OnSaveClick"
                    Content="保存"
                    IsDefault="True" />
            <Button MinWidth="82"
                    Margin="8,0,0,0"
                    Content="取消"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
