<UserControl x:Class="MYTC.App.Views.FilePaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:files="clr-namespace:MYTC.Domain.Files;assembly=MYTC.Domain"
             AllowDrop="True"
             PreviewMouseDown="OnPreviewMouseDown"
             PreviewMouseMove="OnPanePreviewMouseMove"
             PreviewMouseLeftButtonUp="OnPanePreviewMouseLeftButtonUp"
             PreviewDragOver="OnPanePreviewDragOver"
             PreviewDrop="OnPanePreviewDrop">
    <Border x:Name="PaneBorder"
            Background="{StaticResource SurfaceBrush}"
            BorderThickness="1"
            CornerRadius="3">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Role}" Value="Active">
                        <Setter Property="BorderBrush" Value="{StaticResource ActiveBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Role}" Value="Target">
                        <Setter Property="BorderBrush" Value="{StaticResource TargetBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfaceAltBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,3,3,3">
                    <Button Width="29" Padding="0" Content="←" Command="{Binding BackCommand}" ToolTip="后退" />
                    <Button Width="29" Padding="0" Margin="3,0,0,0" Content="→" Command="{Binding ForwardCommand}" ToolTip="前进" />
                    <Button Width="29" Padding="0" Margin="3,0,0,0" Content="↑" Command="{Binding UpCommand}" ToolTip="上级目录" />
                    <Button Width="29" Padding="0" Margin="3,0,0,0" Content="↻" Command="{Binding RefreshCommand}" ToolTip="刷新" />
                </StackPanel>

                <ComboBox Grid.Column="1"
                          Margin="2,3"
                          ItemsSource="{Binding Drives}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                          ToolTip="快速切换盘符" />

                <TextBox x:Name="AddressTextBox"
                         Grid.Column="2"
                         Margin="3"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnAddressKeyDown"
                         ToolTip="输入目录并按 Enter">
                    <TextBox.CommandBindings>
                        <CommandBinding Command="{x:Static ApplicationCommands.Paste}"
                                        CanExecute="OnAddressPasteCanExecute"
                                        Executed="OnAddressPasteExecuted" />
                    </TextBox.CommandBindings>
                </TextBox>

                <Button Grid.Column="3"
                        Width="30"
                        Margin="2,3,4,3"
                        Padding="0"
                        Content="□"
                        Command="{Binding ToggleMaximizeCommand}"
                        ToolTip="最大化或恢复窗格" />
            </Grid>

            <Grid x:Name="TabBarGrid"
                  Grid.Row="1"
                  Background="#EDF0F4"
                  PreviewMouseLeftButtonDown="OnTabBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="TabScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button MinWidth="76"
                                        MaxWidth="190"
                                        Height="28"
                                        Margin="4,2,0,0"
                                        Padding="8,2"
                                        HorizontalContentAlignment="Stretch"
                                        Click="OnTabClick"
                                        PreviewMouseDown="OnTabMouseDown"
                                        ToolTip="{Binding CurrentPath}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#E4E8ED" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource SurfaceBrush}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource ActiveBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ContextMenu>
                                        <ContextMenu Opened="OnTabContextMenuOpened" />
                                    </Button.ContextMenu>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Margin="0,0,5,0"
                                                   Foreground="{StaticResource TargetBrush}"
                                                   Text="◆"
                                                   Visibility="{Binding IsFixed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding DisplayTitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3,2,4,1">
                    <Button Width="27"
                            Height="27"
                            Padding="0"
                            Content="↶"
                            Command="{Binding RestoreClosedTabCommand}"
                            ToolTip="恢复刚关闭的标签" />
                    <Button Width="27"
                            Height="27"
                            Margin="3,0,0,0"
                            Padding="0"
                            Content="+"
                            Command="{Binding NewTabCommand}"
                            ToolTip="新建标签" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <DataGrid x:Name="FileGrid"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          BorderThickness="0"
                          AllowDrop="True"
                          Sorting="OnSorting"
                          SelectionChanged="OnSelectionChanged"
                          PreviewKeyDown="OnFileGridPreviewKeyDown"
                          PreviewMouseLeftButtonDown="OnFileGridMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="OnFileGridMouseRightButtonDown"
                          MouseMove="OnFileGridMouseMove"
                          DragOver="OnFileGridDragOver"
                          Drop="OnFileGridDrop"
                          MouseDoubleClick="OnFileDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="OnFileGridContextMenuOpened" />
                    </DataGrid.ContextMenu>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="24" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="名称"
                                                SortMemberPath="Name"
                                                Width="2.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16"
                                               Height="16"
                                               Margin="1,0,5,0"
                                               SnapsToDevicePixels="True"
                                               Source="{Binding Converter={StaticResource ShellIconConverter}}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="修改日期"
                                            SortMemberPath="ModifiedAt"
                                            Binding="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                            Width="1.25*" />
                        <DataGridTextColumn Header="类型"
                                            SortMemberPath="TypeDisplayName"
                                            Binding="{Binding TypeDisplayName}"
                                            Width="1.1*" />
                        <DataGridTextColumn Header="大小"
                                            SortMemberPath="Size"
                                            Binding="{Binding SizeDisplay}"
                                            Width="0.75*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#CCFFFFFF"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="150" Height="4" IsIndeterminate="True" />
                        <TextBlock Margin="0,8,0,0" Text="正在读取目录…" />
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,7"
                        Padding="6,2"
                        CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="Active">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="#E7F0FC" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="Target">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="#FFF1DF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding RoleLabel}" />
                </Border>
            </Grid>

            <Grid Grid.Row="3" Background="{StaticResource SurfaceAltBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="7,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding StatusText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="7,0">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#B42318"
                               FontSize="11"
                               Text="{Binding ErrorMessage}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Text="{Binding SortSummary}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
