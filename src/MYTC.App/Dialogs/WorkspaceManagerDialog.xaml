<Window x:Class="MYTC.App.Dialogs.WorkspaceManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作区方案管理"
        Width="540"
        Height="390"
        MinWidth="500"
        MinHeight="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                   Text="工作区方案保存四个窗格、标签、目录、排序和活动窗格。导入同名方案时会自动创建新名称，不覆盖原方案。" />

        <ListBox x:Name="WorkspaceListBox"
                 Grid.Row="1"
                 Margin="0,12,0,12"
                 DisplayMemberPath="."
                 ItemsSource="{Binding WorkspaceNames}"
                 SelectedItem="{Binding SelectedWorkspaceName, Mode=TwoWay}"
                 SelectionChanged="OnWorkspaceSelectionChanged" />

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,12"
                    Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center"
                       Text="任务栏图标：" />
            <ComboBox x:Name="WorkspaceIconComboBox"
                      Width="210"
                      SelectedValuePath="Tag">
                <ComboBoxItem Tag="AUTO" Content="自动（按工作区首字母）" />
                <ComboBoxItem Tag="TC" Content="默认 TC 图标" />
                <ComboBoxItem Tag="1" Content="TC + 上标 1" />
                <ComboBoxItem Tag="W" Content="TC + 上标 W" />
            </ComboBox>
            <Button Width="86"
                    Margin="8,0,0,0"
                    Click="OnApplyIconClick"
                    Content="应用图标" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Width="76" Click="OnImportClick" Content="导入…" />
                <Button Width="76" Margin="7,0,0,0" Click="OnExportClick" Content="导出…" />
                <Button Width="76" Margin="7,0,0,0" Click="OnRenameClick" Content="重命名…" />
                <Button Width="76" Margin="7,0,0,0" Click="OnDeleteClick" Content="删除" />
            </StackPanel>
            <Button Grid.Column="1" Width="82" IsCancel="True" Content="关闭" />
        </Grid>
    </Grid>
</Window>
